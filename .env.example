# ── OBLIGATORIAS EN PRODUCCIÓN ───────────────────────────────────────
# El servidor se niega a arrancar sin ellas, en lugar de funcionar a
# medias y perder datos o firmar cookies con una clave conocida.

# Firma HMAC de la cookie de sesión.
#   openssl rand -base64 32
SESSION_SECRET=

# Postgres. Sin ella, en producción el progreso se perdería en cada
# arranque en frío. Aplica el esquema una vez con `npm run db:migrate`.
# DATABASE_URL=postgres://usuario:clave@host/base?sslmode=require

# ── OPCIONALES ───────────────────────────────────────────────────────
# Llave del resumen de observabilidad (/api/insights). Sin ella la ruta
# responde 404 y no existe: errores repetidos y pasos donde la gente se
# atasca son información operativa, no contenido.
#   openssl rand -base64 24
# INSIGHTS_TOKEN=

# ── SOLO DESARROLLO ──────────────────────────────────────────────────
# Sin DATABASE_URL se usa PGlite (Postgres en WASM). Este directorio lo
# hace persistente entre reinicios; sin él la base vive en memoria, que
# es lo deseable en los tests.
PGLITE_DATA_DIR=.pglite
