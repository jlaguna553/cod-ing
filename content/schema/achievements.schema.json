{
  "$id": "https://codequest.dev/schema/achievements.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "title": {
        "type": "object",
        "properties": {
          "es": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "es",
          "en"
        ]
      },
      "description": {
        "type": "object",
        "properties": {
          "es": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "es",
          "en"
        ]
      },
      "icon": {
        "type": "string"
      },
      "tier": {
        "type": "string",
        "enum": [
          "bronze",
          "silver",
          "gold",
          "legendary"
        ]
      },
      "xpReward": {
        "default": 100,
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "trigger": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "combo-reached"
              },
              "value": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "value"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "keystrokes-total"
              },
              "value": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "value"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "lessons-completed"
              },
              "track": {
                "type": "string",
                "enum": [
                  "frontend",
                  "backend",
                  "devops"
                ]
              },
              "value": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "value"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "module-completed"
              },
              "module": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "module"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "flawless-streak"
              },
              "value": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "value"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "no-hint-lessons"
              },
              "value": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "value"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "interview-solved"
              },
              "category": {
                "type": "string"
              },
              "value": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "category",
              "value"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "speed-clear"
              },
              "underSeconds": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "underSeconds"
            ]
          }
        ]
      }
    },
    "required": [
      "id",
      "title",
      "description",
      "icon",
      "tier",
      "trigger"
    ]
  }
}
